# Copy this file to `.env.local` (already gitignored) and fill in.
# Phase 09 wires Turso + Clerk; phase 10 will use Resend.

# -- Turso (SQLite over HTTP) --------------------------------------------
# Get from `turso db show <name>` after creating the DB:
#   turso db create gramly-mortgage-db
#   turso db tokens create gramly-mortgage-db
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# -- Clerk (auth) --------------------------------------------------------
# https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# -- Resend (email) ------------------------------------------------------
# https://resend.com/api-keys
# Needed in phase 09 only if you want the contact route to send mail now;
# otherwise leave blank — phase 10 wires the full email flow.
RESEND_API_KEY=re_...

# -- Site URL ------------------------------------------------------------
# Used by emails + canonical metadata. The production URL — not localhost.
NEXT_PUBLIC_SITE_URL=https://gramly-mortgage.vercel.app
